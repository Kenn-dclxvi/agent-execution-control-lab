{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "general-chat-holdout-reference-panel-run-result-r1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "run_id", "plan_id", "preflight", "dispatch", "slots", "reference_report", "summary", "result_sha256"],
  "properties": {
    "schema_version": {"const": "general-chat-holdout-reference-panel-run-result/v1"},
    "run_id": {"const": "general-chat-semantic-holdout-reference-r1-run-r1"},
    "plan_id": {"const": "general-chat-semantic-qualification-holdout-plan-r1"},
    "preflight": {"$ref": "#/$defs/artifact"},
    "dispatch": {"$ref": "#/$defs/artifact"},
    "slots": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {"$ref": "#/$defs/slot"}
    },
    "reference_report": {"anyOf": [{"$ref": "#/$defs/artifact"}, {"type": "null"}]},
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["authorized_slots", "valid_results", "external_failures", "unrateable_results", "measurement_state"],
      "properties": {
        "authorized_slots": {"const": 3},
        "valid_results": {"type": "integer", "minimum": 0, "maximum": 3},
        "external_failures": {"type": "integer", "minimum": 0, "maximum": 3},
        "unrateable_results": {"type": "integer", "minimum": 0, "maximum": 3},
        "measurement_state": {"enum": ["reference_measurement_established", "reference_measurement_not_established"]}
      }
    },
    "result_sha256": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "slot": {
      "type": "object",
      "additionalProperties": false,
      "required": ["slot_id", "grader_execution_id", "status", "process_exit_code", "elapsed_seconds", "stdout_sha256", "stderr_sha256", "root_thread_id", "total_tokens", "label"],
      "properties": {
        "slot_id": {"type": "string", "pattern": "^holdout-reference-slot-[0-9]{2}$"},
        "grader_execution_id": {"type": "string", "minLength": 1},
        "status": {"enum": ["valid", "external_failure", "unrateable"]},
        "process_exit_code": {"type": "integer"},
        "elapsed_seconds": {"type": "number", "minimum": 0},
        "stdout_sha256": {"$ref": "#/$defs/sha256"},
        "stderr_sha256": {"$ref": "#/$defs/sha256"},
        "root_thread_id": {"type": ["string", "null"]},
        "total_tokens": {"type": ["integer", "null"], "minimum": 0},
        "label": {"anyOf": [{"$ref": "#/$defs/artifact"}, {"type": "null"}]}
      }
    }
  }
}
