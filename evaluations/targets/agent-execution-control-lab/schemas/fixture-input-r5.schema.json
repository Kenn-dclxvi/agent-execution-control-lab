{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "fixture-input-r5.schema.json",
  "type": "object",
  "required": ["schema_version", "case_id", "fixture_revision", "review_contract_revision", "pr", "changed_paths", "changes", "rules"],
  "properties": {
    "schema_version": {"const": 5},
    "case_id": {"enum": ["PRR-C02", "PRR-C03", "PRR-C06"]},
    "fixture_revision": {"const": "r2"},
    "review_contract_revision": {"const": "pr-review-contract-r2"},
    "pr": {
      "type": "object",
      "required": ["title", "body", "base_sha", "head_sha"],
      "properties": {
        "title": {"type": "string", "minLength": 1},
        "body": {"type": "string", "minLength": 1},
        "base_sha": {"pattern": "^[0-9a-f]{40}$"},
        "head_sha": {"pattern": "^[0-9a-f]{40}$"}
      },
      "additionalProperties": false
    },
    "changed_paths": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "changes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["path", "patch", "content_after"],
        "properties": {
          "path": {"type": "string", "minLength": 1},
          "patch": {"type": "string", "minLength": 1},
          "content_after": {"type": "string"}
        },
        "additionalProperties": false
      }
    },
    "rules": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["source", "scope", "rules"],
        "properties": {
          "source": {"type": "string", "minLength": 1},
          "scope": {"type": "string", "minLength": 1},
          "rules": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["rule_id", "text"],
              "properties": {
                "rule_id": {"type": "string", "minLength": 1},
                "text": {"type": "string", "minLength": 1}
              },
              "additionalProperties": false
            }
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
