{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "baseline-measurement-boundary-r1.schema.json",
  "type": "object",
  "required": [
    "schema_version",
    "audit_id",
    "state",
    "baseline_definition",
    "preserved_review_conditions",
    "measurement_adaptations",
    "disallowed_changes",
    "prior_audit",
    "admission_effect"
  ],
  "properties": {
    "schema_version": {"const": "agent-execution-control-lab.pr-review-baseline-measurement-boundary/v1"},
    "audit_id": {"const": "baseline-measurement-boundary-r1"},
    "state": {"const": "satisfied"},
    "baseline_definition": {
      "type": "object",
      "required": ["reference", "reference_repository", "reference_commit", "action", "action_revision", "excluded_reference"]
    },
    "preserved_review_conditions": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "measurement_adaptations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["identity", "purpose", "allowed"],
        "properties": {
          "identity": {"type": "string", "minLength": 1},
          "purpose": {"type": "string", "minLength": 1},
          "allowed": {"const": true}
        },
        "additionalProperties": false
      }
    },
    "disallowed_changes": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "prior_audit": {
      "type": "object",
      "required": ["path", "current_interpretation", "effect"]
    },
    "admission_effect": {"const": "core_baseline_profile_may_proceed_after_preflight"}
  },
  "additionalProperties": false
}
