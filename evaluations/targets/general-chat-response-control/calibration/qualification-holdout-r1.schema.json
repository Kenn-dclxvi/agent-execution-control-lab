{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "general-chat-qualification-holdout-r1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "holdout_set_id",
    "status",
    "evaluation_role",
    "source_protocol",
    "pilot_set_id",
    "pilot_overlap_count",
    "sealed_at",
    "items"
  ],
  "properties": {
    "schema_version": {"const": "general-chat-qualification-holdout/v1"},
    "holdout_set_id": {"const": "general-chat-semantic-qualification-holdout-r1"},
    "status": {"const": "sealed_before_reference_and_qualification"},
    "evaluation_role": {"const": "heldout_grader_qualification"},
    "source_protocol": {"const": "general-chat-response-control/r1"},
    "pilot_set_id": {"const": "general-chat-core-r1-semantic-calibration-r1"},
    "pilot_overlap_count": {"const": 0},
    "sealed_at": {"type": "string", "format": "date-time"},
    "items": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/item"}
    }
  },
  "$defs": {
    "message": {
      "type": "object",
      "additionalProperties": false,
      "required": ["role", "content"],
      "properties": {
        "role": {"enum": ["user", "assistant"]},
        "content": {"type": "string", "minLength": 1}
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["evidence_id", "description", "state"],
      "properties": {
        "evidence_id": {"type": "string", "minLength": 1},
        "description": {"type": "string", "minLength": 1},
        "state": {"type": "string", "minLength": 1},
        "content": {"type": "string", "minLength": 1}
      }
    },
    "assertion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["assertion_id", "severity", "criterion"],
      "properties": {
        "assertion_id": {"type": "string", "minLength": 1},
        "severity": {"enum": ["major", "required", "presentation"]},
        "criterion": {"type": "string", "minLength": 1}
      }
    },
    "item": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "holdout_item_id",
        "case_family",
        "conversation",
        "available_evidence",
        "received_evidence",
        "assistant_message",
        "assertions"
      ],
      "properties": {
        "holdout_item_id": {"type": "string", "pattern": "^GCH-[A-Z][0-9]{2}-[AB]$"},
        "case_family": {"type": "string", "minLength": 1},
        "conversation": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/message"}
        },
        "available_evidence": {
          "type": "array",
          "items": {"$ref": "#/$defs/evidence"}
        },
        "received_evidence": {
          "type": "array",
          "items": {"$ref": "#/$defs/evidence"}
        },
        "assistant_message": {"type": "string", "minLength": 1},
        "assertions": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/assertion"}
        }
      }
    }
  }
}
