{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "fixture-oracle-r2.schema.json",
  "type": "object",
  "required": ["schema_version", "case_id", "fixture_revision", "clean_control", "expected_findings"],
  "properties": {
    "schema_version": {"const": 2},
    "case_id": {"pattern": "^PRR-C0[1-6]$"},
    "fixture_revision": {"const": "r2"},
    "clean_control": {"type": "boolean"},
    "expected_findings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["category", "rule_id", "paths", "locations", "severity"],
        "properties": {
          "category": {"enum": ["repository_discipline", "evaluation_artifact_integrity", "secret_or_private_log", "document_quality"]},
          "rule_id": {"type": "string", "minLength": 1},
          "paths": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
          "locations": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["path", "line_start", "line_end"],
              "properties": {
                "path": {"type": "string", "minLength": 1},
                "line_start": {"type": "integer", "minimum": 1},
                "line_end": {"type": "integer", "minimum": 1}
              },
              "additionalProperties": false
            }
          },
          "severity": {"enum": ["major", "minor"]}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
