{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "run-result-r4.schema.json",
  "type": "object",
  "required": ["schema_version", "comparison_revision", "profile_id", "quality_rating_contract", "result_id", "case_id", "fixture_revision", "variant", "repetition", "attempt", "base_sha", "head_sha", "model", "reviewer_executor", "workflow_revision", "github_run_id", "timing", "runtime", "quality", "quality_score", "result"],
  "properties": {
    "schema_version": {"const": 4},
    "comparison_revision": {"const": "pr-review-core-baseline-qualification-r1"},
    "profile_id": {"const": "pr-review-agentic-retrieval-c01-r3-qualification-n2-r2"},
    "quality_rating_contract": {"const": "pr-review-finding-quality-v3"},
    "result_id": {"type": "string", "minLength": 1},
    "case_id": {"const": "PRR-C01"},
    "fixture_revision": {"const": "r3"},
    "variant": {"const": "agentic-retrieval"},
    "repetition": {"type": "integer", "minimum": 1, "maximum": 2},
    "attempt": {"type": "integer", "minimum": 1},
    "base_sha": {"pattern": "^[0-9a-f]{40}$"},
    "head_sha": {"pattern": "^[0-9a-f]{40}$"},
    "model": {"type": "object"},
    "reviewer_executor": {"type": "object"},
    "workflow_revision": {"const": "pr-review-qualify-core-r2"},
    "github_run_id": {"type": "string"},
    "timing": {"type": "object"},
    "runtime": {"type": "object"},
    "quality": {"type": "object"},
    "quality_score": {"type": ["integer", "null"], "minimum": 0, "maximum": 4},
    "result": {"enum": ["pass", "quality_failed", "invalid_output", "execution_failed", "timeout", "cancelled", "measurement_incomplete"]}
  },
  "additionalProperties": false
}
