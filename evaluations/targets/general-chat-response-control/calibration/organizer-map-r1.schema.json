{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "general-chat-organizer-map-r1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "packet_id", "calibration_set_id", "rater_id", "source_sha256", "mappings"],
  "properties": {
    "schema_version": {"const": "general-chat-organizer-map/v1"},
    "packet_id": {"type": "string", "minLength": 1},
    "calibration_set_id": {"type": "string", "minLength": 1},
    "rater_id": {"type": "string", "minLength": 1},
    "source_sha256": {
      "type": "object",
      "additionalProperties": false,
      "required": ["calibration_input", "model_visible_cases"],
      "properties": {
        "calibration_input": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "model_visible_cases": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "mappings": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["rating_item_id", "calibration_item_id", "case_id", "assertion_ids"],
        "properties": {
          "rating_item_id": {"type": "string", "pattern": "^item-[0-9a-f]{16}$"},
          "calibration_item_id": {"type": "string", "minLength": 1},
          "case_id": {"type": "string", "minLength": 1},
          "assertion_ids": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {"type": "string", "minLength": 1}
          }
        }
      }
    }
  }
}
