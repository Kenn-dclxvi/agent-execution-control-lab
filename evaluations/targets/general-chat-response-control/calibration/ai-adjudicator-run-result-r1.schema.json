{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "run_id", "status", "process_exit_code", "elapsed_seconds", "root_thread_id", "usage", "preflight", "dispatch", "stdout", "stderr", "adjudication", "result_sha256"],
  "properties": {
    "schema_version": {"const": "general-chat-ai-adjudicator-run-result/v1"},
    "run_id": {"const": "general-chat-semantic-pilot-adjudication-r1-run-r1"},
    "status": {"enum": ["valid", "external_failure", "unrateable"]},
    "process_exit_code": {"type": "integer"},
    "elapsed_seconds": {"type": "number", "minimum": 0},
    "root_thread_id": {"type": ["string", "null"]},
    "usage": {"type": ["object", "null"]},
    "preflight": {"$ref": "#/$defs/file"},
    "dispatch": {"$ref": "#/$defs/file"},
    "stdout": {"$ref": "#/$defs/file"},
    "stderr": {"$ref": "#/$defs/file"},
    "adjudication": {"anyOf": [{"$ref": "#/$defs/file"}, {"type": "null"}]},
    "result_sha256": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "file": {"type": "object", "additionalProperties": false, "required": ["path", "sha256"], "properties": {"path": {"type": "string", "minLength": 1}, "sha256": {"$ref": "#/$defs/sha256"}}}
  }
}
