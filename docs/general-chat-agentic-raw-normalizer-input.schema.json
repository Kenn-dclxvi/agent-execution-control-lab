{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/general-chat-agentic-raw-normalizer-input.schema.json",
  "title": "General chat agentic synthetic raw normalizer input",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "probe_id", "root_events", "sessions", "monotonic"],
  "properties": {
    "schema_version": {"const": "general-chat-agentic-synthetic-raw-trace/v1"},
    "probe_id": {"const": "general-chat-agentic-capability-preflight-r1"},
    "root_events": {
      "type": "array",
      "items": {"$ref": "#/$defs/root_event"}
    },
    "sessions": {
      "type": "array",
      "items": {"$ref": "#/$defs/session"}
    },
    "monotonic": {
      "type": "object",
      "additionalProperties": false,
      "required": ["started_ms", "ended_ms"],
      "properties": {
        "started_ms": {"type": "integer", "minimum": 0},
        "ended_ms": {"type": "integer", "minimum": 0}
      }
    }
  },
  "$defs": {
    "root_event": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "thread_id"],
      "properties": {
        "type": {"const": "thread.started"},
        "thread_id": {"type": "string", "minLength": 1}
      }
    },
    "session": {
      "type": "object",
      "additionalProperties": false,
      "required": ["session_meta", "events"],
      "properties": {
        "session_meta": {"$ref": "#/$defs/session_meta"},
        "events": {
          "type": "array",
          "items": {
            "oneOf": [
              {"$ref": "#/$defs/token_count"},
              {"$ref": "#/$defs/task_complete"}
            ]
          }
        }
      }
    },
    "session_meta": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "payload"],
      "properties": {
        "type": {"const": "session_meta"},
        "payload": {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "cwd", "parent_thread_id", "source"],
          "properties": {
            "id": {"type": "string", "minLength": 1},
            "cwd": {"const": "/synthetic/general-chat-agentic-r1"},
            "parent_thread_id": {"type": ["string", "null"]},
            "source": {
              "oneOf": [
                {"const": "root"},
                {"$ref": "#/$defs/subagent_source"}
              ]
            }
          }
        }
      }
    },
    "subagent_source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["subagent"],
      "properties": {
        "subagent": {
          "type": "object",
          "additionalProperties": false,
          "required": ["thread_spawn"],
          "properties": {
            "thread_spawn": {
              "type": "object",
              "additionalProperties": false,
              "required": ["agent_path"],
              "properties": {
                "agent_path": {"type": "string", "minLength": 1}
              }
            }
          }
        }
      }
    },
    "token_count": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "payload"],
      "properties": {
        "type": {"const": "event_msg"},
        "payload": {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "info"],
          "properties": {
            "type": {"const": "token_count"},
            "info": {
              "type": "object",
              "additionalProperties": false,
              "required": ["total_token_usage"],
              "properties": {
                "total_token_usage": {"$ref": "#/$defs/usage"}
              }
            }
          }
        }
      }
    },
    "task_complete": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "payload"],
      "properties": {
        "type": {"const": "event_msg"},
        "payload": {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "last_agent_message"],
          "properties": {
            "type": {"const": "task_complete"},
            "last_agent_message": {"type": "string", "minLength": 1}
          }
        }
      }
    },
    "usage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["input_tokens", "cached_input_tokens", "output_tokens", "total_tokens"],
      "properties": {
        "input_tokens": {"type": "integer", "minimum": 0},
        "cached_input_tokens": {"type": "integer", "minimum": 0},
        "output_tokens": {"type": "integer", "minimum": 0},
        "total_tokens": {"type": "integer", "minimum": 0}
      }
    }
  }
}
