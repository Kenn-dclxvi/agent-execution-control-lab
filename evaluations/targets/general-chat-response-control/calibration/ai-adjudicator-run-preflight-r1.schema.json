{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "receipt_id", "state", "issued_slot_count", "runtime_binding", "adjudicator", "fixed_sources", "storage", "material", "receipt_sha256"],
  "properties": {
    "schema_version": {"const": "general-chat-ai-adjudicator-run-preflight/v1"},
    "receipt_id": {"const": "general-chat-semantic-pilot-adjudication-r1-preflight-r1"},
    "state": {"const": "ready_not_issued"},
    "issued_slot_count": {"const": 0},
    "runtime_binding": {"type": "object"},
    "adjudicator": {
      "type": "object", "additionalProperties": false,
      "required": ["grader_execution_id", "model", "reasoning_effort"],
      "properties": {
        "grader_execution_id": {"const": "semantic-adjudicator-terra-r1"},
        "model": {"const": "gpt-5.6-terra"},
        "reasoning_effort": {"const": "medium"}
      }
    },
    "fixed_sources": {"type": "object", "minProperties": 10},
    "storage": {
      "type": "object", "additionalProperties": false,
      "required": ["run_root", "repository_external"],
      "properties": {"run_root": {"type": "string", "minLength": 1}, "repository_external": {"const": true}}
    },
    "material": {
      "type": "object", "additionalProperties": false,
      "required": ["packet", "transport_schema", "stdin"],
      "properties": {"packet": {"$ref": "#/$defs/file"}, "transport_schema": {"$ref": "#/$defs/file"}, "stdin": {"$ref": "#/$defs/file"}}
    },
    "receipt_sha256": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "file": {"type": "object", "additionalProperties": false, "required": ["path", "sha256"], "properties": {"path": {"type": "string", "minLength": 1}, "sha256": {"$ref": "#/$defs/sha256"}}}
  }
}
