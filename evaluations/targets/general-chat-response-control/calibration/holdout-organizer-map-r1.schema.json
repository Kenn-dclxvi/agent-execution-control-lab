{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "general-chat-holdout-organizer-map-r1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "packet_id", "holdout_set_id", "grader_execution_id", "source_sha256", "mappings"],
  "properties": {
    "schema_version": {"const": "general-chat-holdout-organizer-map/v1"},
    "packet_id": {"type": "string", "minLength": 1},
    "holdout_set_id": {"const": "general-chat-semantic-qualification-holdout-r1"},
    "grader_execution_id": {"type": "string", "minLength": 1},
    "source_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "mappings": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["rating_item_id", "holdout_item_id", "assertion_ids"],
        "properties": {
          "rating_item_id": {"type": "string", "pattern": "^item-[0-9a-f]{16}$"},
          "holdout_item_id": {"type": "string", "pattern": "^GCH-[A-Z][0-9]{2}-[AB]$"},
          "assertion_ids": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {"type": "string", "minLength": 1}
          }
        }
      }
    }
  }
}
