{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/general-chat-agentic-binding-extractor-input-r2.schema.json",
  "title": "General chat agentic normalized binding trace r2",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "probe_id", "root", "descendants", "usage", "monotonic", "projection"],
  "properties": {
    "schema_version": {"const": "general-chat-agentic-normalized-trace/v1"},
    "probe_id": {"const": "general-chat-agentic-capability-preflight-r2"},
    "root": {
      "type": "object",
      "additionalProperties": false,
      "required": ["thread_started", "spawn_calls", "spawn_results", "tool_calls", "tool_results", "final_responses"],
      "properties": {
        "thread_started": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "spawn_calls": {"type": "array", "items": {"$ref": "#/$defs/spawn_call"}},
        "spawn_results": {"type": "array", "items": {"$ref": "#/$defs/spawn_result"}},
        "tool_calls": {"type": "array", "items": {"$ref": "#/$defs/tool_call"}},
        "tool_results": {"type": "array", "items": {"$ref": "#/$defs/tool_result"}},
        "final_responses": {"type": "array", "items": {"type": "string"}}
      }
    },
    "descendants": {"type": "array", "items": {"$ref": "#/$defs/descendant"}},
    "usage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["root_thread_id", "sessions"],
      "properties": {
        "root_thread_id": {"type": ["string", "null"]},
        "sessions": {"type": "array", "items": {"$ref": "#/$defs/session_usage"}}
      }
    },
    "monotonic": {
      "type": "object",
      "additionalProperties": false,
      "required": ["started_ms", "ended_ms"],
      "properties": {
        "started_ms": {"type": ["integer", "null"], "minimum": 0},
        "ended_ms": {"type": ["integer", "null"], "minimum": 0}
      }
    },
    "projection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["raw_transcript_required"],
      "properties": {"raw_transcript_required": {"type": "boolean"}}
    }
  },
  "$defs": {
    "spawn_call": {
      "type": "object",
      "additionalProperties": false,
      "required": ["call_id", "requested_task_identity", "packet"],
      "properties": {
        "call_id": {"type": ["string", "null"]},
        "requested_task_identity": {"type": ["string", "null"]},
        "packet": {"type": ["object", "null"]}
      }
    },
    "spawn_result": {
      "type": "object",
      "additionalProperties": false,
      "required": ["call_id", "returned_task_identity", "child_thread_id"],
      "properties": {
        "call_id": {"type": ["string", "null"]},
        "returned_task_identity": {"type": ["string", "null"]},
        "child_thread_id": {"type": ["string", "null"]}
      }
    },
    "tool_call": {
      "type": "object",
      "additionalProperties": false,
      "required": ["call_id", "tool_id", "input"],
      "properties": {
        "call_id": {"type": ["string", "null"]},
        "tool_id": {"type": ["string", "null"]},
        "input": {"type": ["object", "null"]}
      }
    },
    "tool_result": {
      "type": "object",
      "additionalProperties": false,
      "required": ["call_id", "terminal_status", "result"],
      "properties": {
        "call_id": {"type": ["string", "null"]},
        "terminal_status": {"enum": ["success", "failed", "unavailable", null]},
        "result": {"type": ["object", "null"]}
      }
    },
    "terminal_event": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sender", "result"],
      "properties": {
        "sender": {"type": ["string", "null"]},
        "result": {"type": ["string", "null"]}
      }
    },
    "descendant": {
      "type": "object",
      "additionalProperties": false,
      "required": ["thread_id", "parent_thread_id", "task_identity", "terminal_events"],
      "properties": {
        "thread_id": {"type": ["string", "null"]},
        "parent_thread_id": {"type": ["string", "null"]},
        "task_identity": {"type": ["string", "null"]},
        "terminal_events": {"type": "array", "items": {"$ref": "#/$defs/terminal_event"}}
      }
    },
    "session_usage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["thread_id", "parent_thread_id", "input_tokens", "cached_input_tokens", "output_tokens", "total_tokens"],
      "properties": {
        "thread_id": {"type": ["string", "null"]},
        "parent_thread_id": {"type": ["string", "null"]},
        "input_tokens": {"type": ["integer", "null"], "minimum": 0},
        "cached_input_tokens": {"type": ["integer", "null"], "minimum": 0},
        "output_tokens": {"type": ["integer", "null"], "minimum": 0},
        "total_tokens": {"type": ["integer", "null"], "minimum": 0}
      }
    }
  }
}
