{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "authority-selection-r1.schema.json",
  "type": "object",
  "required": [
    "schema_version",
    "collector_revision",
    "target_repository_ref",
    "selection_rule",
    "changed_paths",
    "path_bindings",
    "authorities"
  ],
  "properties": {
    "schema_version": {"const": "agent-execution-control-lab.pr-review-authority-selection/v1"},
    "collector_revision": {"const": "pr-review-authority-collector-r1"},
    "target_repository_ref": {
      "type": "object",
      "required": ["commit", "tree"],
      "properties": {
        "commit": {"pattern": "^[0-9a-f]{40}$"},
        "tree": {"pattern": "^[0-9a-f]{40}$"}
      },
      "additionalProperties": false
    },
    "selection_rule": {
      "type": "object",
      "required": ["root", "local"],
      "properties": {"root": {"type": "string"}, "local": {"type": "string"}},
      "additionalProperties": false
    },
    "changed_paths": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
    "path_bindings": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["changed_path", "applicable_authorities"],
        "properties": {
          "changed_path": {"type": "string"},
          "applicable_authorities": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}}
        },
        "additionalProperties": false
      }
    },
    "authorities": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "source_path", "source_mode", "source_blob_sha1", "symlink_target",
          "resolved_path", "resolved_mode", "resolved_blob_sha1", "content_sha256",
          "content_bytes", "authority_role", "applies_to"
        ],
        "properties": {
          "source_path": {"type": "string"},
          "source_mode": {"enum": ["100644", "120000"]},
          "source_blob_sha1": {"pattern": "^[0-9a-f]{40}$"},
          "symlink_target": {"type": ["string", "null"]},
          "resolved_path": {"type": "string"},
          "resolved_mode": {"const": "100644"},
          "resolved_blob_sha1": {"pattern": "^[0-9a-f]{40}$"},
          "content_sha256": {"pattern": "^[0-9a-f]{64}$"},
          "content_bytes": {"type": "integer", "minimum": 0},
          "authority_role": {"enum": ["root", "local"]},
          "applies_to": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
