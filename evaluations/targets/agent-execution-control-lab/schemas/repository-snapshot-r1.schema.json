{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "repository-snapshot-r1.schema.json",
  "type": "object",
  "required": [
    "schema_version", "snapshot_revision", "target_repository_ref", "fixture",
    "overlay_paths", "file_count", "regular_file_bytes", "available_paths_sha256",
    "snapshot_sha256", "workspace_boundary"
  ],
  "properties": {
    "schema_version": {"const": "agent-execution-control-lab.pr-review-repository-snapshot/v1"},
    "snapshot_revision": {"const": "pr-review-repository-snapshot-r1"},
    "target_repository_ref": {
      "type": "object",
      "required": ["commit", "tree"],
      "properties": {
        "commit": {"pattern": "^[0-9a-f]{40}$"},
        "tree": {"pattern": "^[0-9a-f]{40}$"}
      },
      "additionalProperties": false
    },
    "fixture": {
      "type": "object",
      "required": ["case_id", "revision", "input_sha256"],
      "properties": {
        "case_id": {"type": "string", "minLength": 1},
        "revision": {"type": "string", "minLength": 1},
        "input_sha256": {"pattern": "^[0-9a-f]{64}$"}
      },
      "additionalProperties": false
    },
    "overlay_paths": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
    "file_count": {"type": "integer", "minimum": 1},
    "regular_file_bytes": {"type": "integer", "minimum": 0},
    "available_paths_sha256": {"pattern": "^[0-9a-f]{64}$"},
    "snapshot_sha256": {"pattern": "^[0-9a-f]{64}$"},
    "workspace_boundary": {
      "type": "object",
      "required": ["git_directory_present", "write_allowed"],
      "properties": {
        "git_directory_present": {"const": false},
        "write_allowed": {"const": false}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
