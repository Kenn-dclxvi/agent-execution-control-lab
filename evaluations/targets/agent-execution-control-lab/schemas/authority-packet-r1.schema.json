{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "authority-packet-r1.schema.json",
  "type": "object",
  "required": ["schema_version", "target_repository_ref", "selection_receipt", "path_bindings", "authorities"],
  "properties": {
    "schema_version": {"const": "agent-execution-control-lab.pr-review-authority-packet/v1"},
    "target_repository_ref": {
      "type": "object",
      "required": ["commit", "tree"],
      "properties": {
        "commit": {"pattern": "^[0-9a-f]{40}$"},
        "tree": {"pattern": "^[0-9a-f]{40}$"}
      },
      "additionalProperties": false
    },
    "selection_receipt": {
      "type": "object",
      "required": ["path", "sha256"],
      "properties": {
        "path": {"type": "string"},
        "sha256": {"pattern": "^[0-9a-f]{64}$"}
      },
      "additionalProperties": false
    },
    "path_bindings": {"type": "array", "minItems": 1},
    "authorities": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["source_path", "resolved_path", "authority_role", "applies_to", "content_sha256", "content"],
        "properties": {
          "source_path": {"type": "string"},
          "resolved_path": {"type": "string"},
          "authority_role": {"enum": ["root", "local"]},
          "applies_to": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
          "content_sha256": {"pattern": "^[0-9a-f]{64}$"},
          "content": {"type": "string"}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
