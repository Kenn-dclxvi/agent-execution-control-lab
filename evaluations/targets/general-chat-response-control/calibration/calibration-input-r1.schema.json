{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "general-chat-calibration-input-r1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "calibration_set_id", "evaluation_role", "qualification_reuse", "source_protocol", "source_artifacts", "items"],
  "properties": {
    "schema_version": {"const": "general-chat-calibration-input/v1"},
    "calibration_set_id": {"type": "string", "minLength": 1},
    "evaluation_role": {"const": "semantic_grader_development_pilot"},
    "qualification_reuse": {"const": "prohibited"},
    "source_protocol": {"type": "string", "minLength": 1},
    "source_artifacts": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["role", "path", "sha256"],
        "properties": {
          "role": {"enum": ["model_visible_cases", "model_invisible_oracle", "historical_result"]},
          "path": {"type": "string", "minLength": 1},
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
        }
      }
    },
    "items": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/item"}
    }
  },
  "$defs": {
    "item": {
      "type": "object",
      "additionalProperties": false,
      "required": ["calibration_item_id", "case_id", "source_kind", "assistant_message", "assertions"],
      "properties": {
        "calibration_item_id": {"type": "string", "minLength": 1},
        "case_id": {"type": "string", "minLength": 1},
        "source_kind": {"enum": ["historical_saved_response", "constructed_challenge", "future_natural_response"]},
        "source_result_id": {"type": ["string", "null"]},
        "assistant_message": {"type": "string", "minLength": 1},
        "assertions": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["assertion_id", "severity", "criterion"],
            "properties": {
              "assertion_id": {"type": "string", "minLength": 1},
              "severity": {"enum": ["major", "required", "presentation"]},
              "criterion": {"type": "string", "minLength": 1}
            }
          }
        }
      }
    }
  }
}
