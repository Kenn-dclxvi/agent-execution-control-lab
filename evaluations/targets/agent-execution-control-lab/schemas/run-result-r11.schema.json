{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "run-result-r11.schema.json",
  "type": "object",
  "required": ["schema_version", "comparison_revision", "profile_id", "quality_rating_contract", "result_id", "case_id", "fixture_revision", "variant", "repetition", "attempt", "base_sha", "head_sha", "model", "reviewer_executor", "workflow_revision", "workflow_trace", "measurement_qualification", "github_run_id", "timing", "runtime", "quality", "quality_score", "result"],
  "properties": {
    "schema_version": {"const": 11},
    "comparison_revision": {"const": "pr-review-workflow-free-calibration-r1"},
    "profile_id": {"const": "pr-review-workflow-free-c01-r4-calibration-n2-r1"},
    "quality_rating_contract": {"const": "pr-review-finding-quality-v5"},
    "result_id": {"type": "string", "minLength": 1},
    "case_id": {"const": "PRR-C01"},
    "fixture_revision": {"const": "r4"},
    "variant": {"const": "workflow-free"},
    "repetition": {"type": "integer", "minimum": 1, "maximum": 2},
    "attempt": {"type": "integer", "minimum": 1},
    "base_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "head_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "model": {"type": "object"},
    "reviewer_executor": {"type": "object"},
    "workflow_revision": {"const": "pr-review-measure-workflow-free-r1"},
    "workflow_trace": {
      "type": "object",
      "required": ["complete", "agent_model_groups", "subagent_usage_observed", "subagent_start_count", "subagent_stop_count", "fixture_tool_access_count", "fixture_tool_access_observed", "fixture_tool_permission_denials", "permission_denials_by_tool", "usage_records", "all_agent_input_tokens", "all_agent_output_tokens"],
      "properties": {
        "complete": {"type": "boolean"},
        "agent_model_groups": {"type": "array"},
        "subagent_usage_observed": {"type": "boolean"},
        "subagent_start_count": {"type": "integer", "minimum": 0},
        "subagent_stop_count": {"type": "integer", "minimum": 0},
        "fixture_tool_access_count": {"type": "integer", "minimum": 0},
        "fixture_tool_access_observed": {"type": "boolean"},
        "fixture_tool_permission_denials": {"type": "integer", "minimum": 0},
        "permission_denials_by_tool": {"type": "object", "additionalProperties": {"type": "integer", "minimum": 0}},
        "usage_records": {"type": "integer", "minimum": 0},
        "all_agent_input_tokens": {"type": ["integer", "null"], "minimum": 0},
        "all_agent_output_tokens": {"type": ["integer", "null"], "minimum": 0},
        "hook_event_count": {"type": "integer", "minimum": 0}
      }
    },
    "measurement_qualification": {
      "type": "object",
      "required": ["state", "action_completed", "structured_output_valid", "reported_model_matches_requested", "all_agent_tokens_complete", "elapsed_time_complete", "fixture_access_observed", "fixture_permission_denials"],
      "properties": {
        "state": {"enum": ["satisfied", "unsatisfied"]},
        "action_completed": {"type": "boolean"},
        "structured_output_valid": {"type": "boolean"},
        "reported_model_matches_requested": {"type": "boolean"},
        "all_agent_tokens_complete": {"type": "boolean"},
        "elapsed_time_complete": {"type": "boolean"},
        "fixture_access_observed": {"type": "boolean"},
        "fixture_permission_denials": {"type": "integer", "minimum": 0}
      }
    },
    "github_run_id": {"type": "string"},
    "timing": {"type": "object"},
    "runtime": {"type": "object"},
    "quality": {"type": "object"},
    "quality_score": {"type": ["integer", "null"], "minimum": 0, "maximum": 4},
    "result": {"enum": ["pass", "quality_failed", "invalid_output", "execution_failed", "timeout", "cancelled", "measurement_incomplete"]}
  },
  "additionalProperties": false
}
