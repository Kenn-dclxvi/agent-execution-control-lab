    "evidence_request_selection",
    "independent_topic_answering",
    "partial_uncertainty_scope",
    "post_sufficiency_request",
    "internal_control_term_exposure"
  ],
  "non_goals": [
    "模範回答との全文一致",
    "特定の文章構成またはtool順の要求",
    "別targetのquality_scoreとの比較",
    "tokenまたはelapsedの推定"
  ]
}
